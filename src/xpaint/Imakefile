	$(XBMDIR)/wait1.xbm $(XBMDIR)/wait2.xbm \
	$(XBMDIR)/wait3.xbm $(XBMDIR)/wait4.xbm
readRC.o: image.h rc.h misc.h DefaultRC.txt.h
size.o: Paint.h messages.h misc.h text.h
screenshot.o: Paint.h image.h messages.h
