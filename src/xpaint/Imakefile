          "-DSHAREDIR=\"$(SHAREDIR)\"" \
          "-DXAPPLOADDIR=\"$(XAPPLOADDIR)\"" \
	  "-DXPAINT_VERSION=\"$(VERSION)\"" \

#ifdef LPCCMD
DEFINES += "-DLPCCMD=\"$(LPCCMD)\""
#endif

#ifdef PRINTCAP
DEFINES += "-DPRINTCAP=\"$(PRINTCAP)\""
#endif

